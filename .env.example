# The public URL of the site
NEXT_PUBLIC_SITE_URL=

# Resend API key for transactional email
RESEND_API_KEY=

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=

# Verified sender for transactional email (defaults to Resend's sandbox sender)
RESEND_FROM=

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_ID=

# Google Tag Manager container ID
NEXT_PUBLIC_GTM_ID=

# Google Apps Script Web App URL that appends each lead to the spreadsheet.
# Leave empty to disable the spreadsheet mirror entirely (email still sends).
SHEETS_WEBHOOK_URL=
# Shared secret checked by the Apps Script before it writes a row.
SHEETS_SHARED_SECRET=

# Groq API key for the /api/ask tax assistant (free tier, server-only).
# Leave empty to keep the assistant gracefully switched off.
GROQ_API_KEY=
# Optional override of the model (default: llama-3.3-70b-versatile).
GROQ_MODEL=

# Meta (Facebook) Pixel — leave EMPTY unless a campaign is live.
# Empty means no pixel script, no cookies, no request to Meta.
NEXT_PUBLIC_META_PIXEL_ID=
